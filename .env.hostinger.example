# Hostinger production env
# If app is hosted at domain root, keep '/'.
# If app is hosted in subfolder (example: https://domain.com/portal/), set '/portal/'.
VITE_PUBLIC_BASE_PATH=/

# WordPress site URL (no trailing slash)
VITE_WP_SITE_URL=https://your-domain.com

# WordPress plugin API base URL (no trailing slash)
VITE_WP_BASE_URL=https://your-domain.com/wp-json/app/v1
